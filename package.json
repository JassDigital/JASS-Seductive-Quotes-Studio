{
  "name": "jass-seductive-quotes-studio",
  "version": "1.2.0",
  "private": true,
  "description": "Local-first literary quote studio with intelligent candidate filtering, bulk review, and persistent SQLite library.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "jszip": "^3.10.1",
    "pdf-parse": "1.1.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "cross-env": "^7.0.3",
    "@electron/rebuild": "^3.7.1"
  }
}
